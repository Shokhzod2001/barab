<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <!-- Geometric Background -->
  <div class="geometric-bg">
    <div
      class="shape circle"
      style="
        width: 60px;
        height: 60px;
        top: 10%;
        left: 15%;
        animation-delay: 0s;
      "
    ></div>
    <div
      class="shape square"
      style="
        width: 40px;
        height: 40px;
        top: 70%;
        right: 20%;
        animation-delay: -5s;
      "
    ></div>
    <div
      class="shape triangle"
      style="top: 30%; left: 80%; animation-delay: -10s"
    ></div>
    <div
      class="shape circle"
      style="
        width: 80px;
        height: 80px;
        bottom: 20%;
        left: 10%;
        animation-delay: -15s;
      "
    ></div>
    <div
      class="shape square"
      style="
        width: 50px;
        height: 50px;
        top: 50%;
        right: 10%;
        animation-delay: -20s;
      "
    ></div>
  </div>

  <div class="main-container">
    <div class="auth-card">
      <!-- Left Section with Brand -->
      <div class="left-section">
        <div class="brand-showcase">
          <div class="logo-container">
            <div class="logo-text">BARAB</div>
          </div>

          <div class="brand-metrics">
            <div class="metric">
              <div class="metric-number">50+</div>
              <div class="metric-label">Restaurants</div>
            </div>
            <div class="metric">
              <div class="metric-number">5k+</div>
              <div class="metric-label">Orders/Day</div>
            </div>
            <div class="metric">
              <div class="metric-number">99.9%</div>
              <div class="metric-label">Uptime</div>
            </div>
          </div>
        </div>

        <div class="welcome-text">
          <h1 class="welcome-title">Barab Admin</h1>
          <p class="welcome-subtitle">
            Lightning fast food restaurant management built for high-volume food
            service.
          </p>
        </div>
      </div>

      <!-- Right Section with Action Buttons -->
      <div class="right-section">
        <div class="action-selector">
          <h2 class="selector-title">Admin Portal</h2>
          <p class="selector-subtitle">
            Access your restaurant management dashboard
          </p>

          <div class="action-buttons">
            <button class="action-btn login" onclick="navigateToLogin()">
              Sign In
            </button>
            <button class="action-btn signup" onclick="navigateToSignup()">
              Create Account
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
