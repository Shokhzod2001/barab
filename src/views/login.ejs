<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <!-- Geometric Background -->
  <div class="geometric-bg">
    <div
      class="shape circle"
      style="
        width: 60px;
        height: 60px;
        top: 10%;
        left: 15%;
        animation-delay: 0s;
      "
    ></div>
    <div
      class="shape square"
      style="
        width: 40px;
        height: 40px;
        top: 70%;
        right: 20%;
        animation-delay: -5s;
      "
    ></div>
    <div
      class="shape triangle"
      style="top: 30%; left: 80%; animation-delay: -10s"
    ></div>
    <div
      class="shape circle"
      style="
        width: 80px;
        height: 80px;
        bottom: 20%;
        left: 10%;
        animation-delay: -15s;
      "
    ></div>
    <div
      class="shape square"
      style="
        width: 50px;
        height: 50px;
        top: 50%;
        right: 10%;
        animation-delay: -20s;
      "
    ></div>
  </div>

  <div class="main-container">
    <div class="auth-card">
      <!-- Left Section with Brand -->
      <div class="left-section">
        <div class="brand-showcase">
          <div class="logo-container">
            <div class="logo-text">BARAB</div>
          </div>

          <div class="brand-metrics">
            <div class="metric">
              <div class="metric-number">50+</div>
              <div class="metric-label">Restaurants</div>
            </div>
            <div class="metric">
              <div class="metric-number">5K+</div>
              <div class="metric-label">Orders/Day</div>
            </div>
            <div class="metric">
              <div class="metric-number">99.9%</div>
              <div class="metric-label">Uptime</div>
            </div>
          </div>
        </div>

        <div class="welcome-text">
          <h1 class="welcome-title">Barab Admin</h1>
          <p class="welcome-subtitle">
            Advanced restaurant management platform for modern businesses.
            Streamline operations and boost efficiency.
          </p>
        </div>
      </div>

      <!-- Right Section with Forms -->
      <div class="right-section">
        <!-- Login Form -->
        <div class="form-container active" id="loginForm">
          <div class="form-title">Welcome Back</div>

          <form
            onsubmit="handleLogin(event)"
            action="/admin/login"
            METHOD="POST"
          >
            <div class="form-group">
              <label>Name</label>
              <input
                type="text"
                name="memberNick"
                class="form-input"
                placeholder="Enter your name"
                required
              />
            </div>

            <div class="form-group">
              <label>Password</label>
              <input
                type="password"
                name="memberPassword"
                class="form-input"
                placeholder="Enter your password"
                required
              />
            </div>

            <button type="submit" class="submit-btn">Access Dashboard</button>

            <a href="/admin" class="back-link">
              <button type="button" class="submit-btn back-btn">
                ← Back
              </button></a
            >
          </form>

          <div class="social-section">
            <div class="social-divider">
              <span>or continue with</span>
            </div>
            <div class="social-buttons">
              <a href="/auth/admin/google" class="social-btn">
                <span><i class="fa-brands fa-google fa-beat"></i></span> Google
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>
