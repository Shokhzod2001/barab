<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/chefs.css" />

<body>
  <!-- Animated Background Elements -->
  <div class="background-elements">
    <div class="bg-element bg-element-1"></div>
    <div class="bg-element bg-element-2"></div>
    <div class="bg-element bg-element-3"></div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-container">
      <div class="logo">
        <div class="logo-icon">B</div>
        <div class="logo-text">
          <h1>Barab Restaurant</h1>
          <p>Admin Dashboard</p>
        </div>
      </div>
      <a href="/admin/logout">
        <button
          class="logout-btn"
          onclick="return confirm('Do you really want to logout?')"
        >
          <i data-lucide="log-out"></i>
          Logout
        </button>
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <!-- Navigation Tabs -->
    <div class="tabs-container">
      <a href="/admin/user/all">
        <button class="tab-btn active">
          <i data-lucide="users"></i>
          <span>Users</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/chef/all">
        <button class="tab-btn active">
          <i data-lucide="chef-hat"></i>
          <span>Chefs</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/product/all">
        <button class="tab-btn active">
          <i data-lucide="menu"></i>
          <span>Menu</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/reserve/all">
        <button class="tab-btn active">
          <i data-lucide="calendar-check"></i>
          <span>Reserves</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
    </div>

    <!-- Filters -->
    <div class="filters-container">
      <div class="search-container">
         <i data-lucide="search" class="search-icon"></i>
        <input
          type="text"
          id="searchInput"
          placeholder="Search anything..."
          oninput="handleSearch()"
          class="search-input"
        />
      </div>
      <select
        id="statusFilter"
        onchange="handleStatusFilter()"
        class="status-filter"
      >
        <option value="all">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Block</option>
        <option value="blocked">Delete</option>
      </select>
    </div>

    <!-- Content -->
    <div class="users-container">
      <div class="users-header">
        <h2>
          <i data-lucide="chef-hat" style="color: #3b26d9;"></i>
          Chefs Management
        </h2>
      </div>
      <div class="overflow-x-auto">
        <table class="users-table">
          <thead>
            <tr>
              <th>Chef</th>
              <th>Contact</th>
              <th>Status</th>
              <th>Experience</th>
              <th>Shift</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <% chefs.forEach((user, index) => { %>
              <tr>
                <td>
                  <div class="user-cell">
                    <img
                      src="<%= baseUrl %>/<%=user.memberImage%>"
                      alt="<%= user.memberNick %>"
                      class="user-avatar"
                    />
                    <div class="status-dot"></div>
                    <div class="user-info">
                      <div class="user-name"><%= user.memberNick %></div>
                      <div class="user-id">
                        ID: #<%= (index + 1).toString().padStart(3, "0") %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="contact-cell">
                    <div class="contact-item phone">
                      <i data-lucide="phone"></i>
                      <%= user.memberPhone %>
                    </div>
                  </div>
                </td>
                <td>
                  <select
                    id="<%= user._id %>"
                    class="member-status status-select status-<%= user.memberStatus %>"
                  >
                    <option value="ACTIVE" <%= user.memberStatus === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                    <option value="BLOCK" <%= user.memberStatus === 'BLOCK' ? 'selected' : '' %>>Block</option>
                    <option value="DELETE" <%= user.memberStatus === 'DELETE' ? 'selected' : '' %>>Delete</option>
                  </select>
                </td>
                <td>
                <div class="date-cell">
                  <div class="contact-item">
                    <i data-lucide="clock" style="color: gray;"></i>
                    <%= user.memberExperience %> years
                  </div>  
                </div>
                </td>
                <td>
                <div class="date-cell">
                  <div class="contact-item shift">
                    <%= user.memberShift %>
                  </div>  
                </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

        
        <!-- Add Chef Button -->
        <div class="add-chef-btn-container">
            <button class="add-chef-btn" onclick="showAddChefForm()">
                <i data-lucide="plus"></i> Add Chef
            </button>
        </div>

                <!-- Add Chef Form Modal -->
        <div class="modal-overlay" id="addChefModal" style="display: none;">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>Add New Chef</h3>
                    <button class="close-btn" onclick="hideAddChefForm()">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                
                <form id="addChefForm" action="/admin/chef/create" method="post" class="chef-form" enctype="multipart/form-data">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="memberNick">Chef Name</label>
                            <input type="text" id="memberNick" name="memberNick" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="memberPhone">Phone Number</label>
                            <input type="text" id="memberPhone" name="memberPhone" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="memberExperience">Experience (years)</label>
                            <input type="number" id="memberExperience" name="memberExperience" min="0" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="memberShift">Shift</label>
                            <select id="memberShift" name="memberShift" required>
                                <option value="">Select a shift</option>
                                <option value="MORNING">Morning</option>
                                <option value="EVENING">Evening</option>
                                <option value="NIGHT">Night</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="memberDesc">Description</label>
                        <textarea id="memberDesc" name="memberDesc" rows="3" placeholder="Brief description of the chef's specialties or background..."></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="memberImage">Chef Image</label>
                        <div class="image-uploader">
                            <input type="file" id="memberImage" name="memberImage" accept="image/*" required>
                            <label for="memberImage" class="upload-label">
                                <i data-lucide="upload"></i>
                                <span>Click to upload image</span>
                            </label>
                            <div class="image-preview" id="imagePreview"></div>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <button type="button" class="cancel-btn" onclick="hideAddChefForm()">Cancel</button>
                        <button type="submit" class="create-btn">Create</button>
                    </div>
                </form>
            </div>
        </div>
  </main>

  <script src="https://unpkg.com/lucide@latest"></script>
  <script type="text/javascript" src="/js/chefs.js"></script>
</body>

<%- include('includes/footer') %>
