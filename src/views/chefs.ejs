<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/chefs.css" />

<body>
  <!-- Animated Background Elements -->
  <div class="background-elements">
    <div class="bg-element bg-element-1"></div>
    <div class="bg-element bg-element-2"></div>
    <div class="bg-element bg-element-3"></div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-container">
      <div class="logo">
        <div class="logo-icon">B</div>
        <div class="logo-text">
          <h1>Barab Restaurant</h1>
          <p>Admin Dashboard</p>
        </div>
      </div>
      <a href="/admin/logout">
        <button
          class="logout-btn"
          onclick="return confirm('Do you really want to logout?')"
        >
          <i data-lucide="log-out"></i>
          Logout
        </button>
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <!-- Navigation Tabs -->
    <div class="tabs-container">
      <a href="/admin/user/all">
        <button class="tab-btn active">
          <i data-lucide="users"></i>
          <span>Users</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/chef/all">
        <button class="tab-btn active">
          <i data-lucide="chef-hat"></i>
          <span>Chefs</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/product/all">
        <button class="tab-btn active">
          <i data-lucide="menu"></i>
          <span>Menu</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
    </div>

    <!-- Filters -->
    <div class="filters-container">
      <div class="search-container">
        <i data-lucide="search" class="search-icon"></i>
        <input
          type="text"
          id="searchInput"
          placeholder="Search anything..."
          oninput="handleSearch()"
          class="search-input"
        />
      </div>
      <select
        id="statusFilter"
        onchange="handleStatusFilter()"
        class="status-filter"
      >
        <option value="all">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
        <option value="blocked">Blocked</option>
      </select>
    </div>

    <!-- Content -->
    <div class="users-container">
      <div class="users-header">
        <h2>
          <i data-lucide="users"></i>
          Users Management
        </h2>
      </div>
      <div class="overflow-x-auto">
        <table class="users-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Contact</th>
              <th>Status</th>
              <th>Join Date</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <!-- Users will be dynamically inserted here -->
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script type="text/javascript" src="/js/chefs.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</body>

<%- include('includes/footer') %>
