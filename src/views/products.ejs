<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <!-- Animated Background Elements -->
  <div class="background-elements">
    <div class="bg-element bg-element-1"></div>
    <div class="bg-element bg-element-2"></div>
    <div class="bg-element bg-element-3"></div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-container">
      <div class="logo">
        <div class="logo-icon">B</div>
        <div class="logo-text">
          <h1>Barab Restaurant</h1>
          <p>Admin Dashboard</p>
        </div>
      </div>
      <a href="/admin/logout">
        <button
          class="logout-btn"
          onclick="return confirm('Do you really want to logout?')"
        >
          <i data-lucide="log-out"></i>
          Logout
        </button>
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <!-- Navigation Tabs -->
    <div class="tabs-container">
      <a href="/admin/user/all">
        <button class="tab-btn active">
          <i data-lucide="users"></i>
          <span>Users</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/chef/all">
        <button class="tab-btn active">
          <i data-lucide="chef-hat"></i>
          <span>Chefs</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/product/all">
        <button class="tab-btn active">
          <i data-lucide="menu"></i>
          <span>Menu</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
      <a href="/admin/reserve/all">
        <button class="tab-btn active">
          <i data-lucide="calendar-check"></i>
          <span>Reserves</span>
          <div class="pulse-dot"></div>
        </button>
      </a>
    </div>

    <!-- Filters -->
    <div class="filters-container">
      <div class="search-container">
         <i data-lucide="search" class="search-icon"></i>
        <input
          type="text"
          id="searchInput"
          placeholder="Search anything..."
          oninput="handleSearch()"
          class="search-input"
        />
      </div>
      <select
        id="statusFilter"
        onchange="handleStatusFilter()"
        class="status-filter"
      >
        <option value="all">All Status</option>
        <option value="active">Process</option>
        <option value="inactive">Pause</option>
        <option value="blocked">Delete</option>
      </select>
    </div>

    <!-- Content -->
    <div class="users-container">
      <div class="users-header">
        <h2>
          <i data-lucide="hamburger" style="color: #3b26d9;"></i>
         Barab Menu
        </h2>
      </div>
      <div class="overflow-x-auto">
        <table class="users-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Category</th>
              <th>Price</th>
              <th>Status</th>
              <th>Left Count</th>
            </tr>
          </thead>
          <tbody id="usersTableBody">
            <% products.forEach((product, index) => { %>
              <tr>
                <td>
                  <div class="user-cell">
                    <img
                      src="<%= baseUrl %>/<%=product.productImages[0]%>"
                      alt="<%= product.productName %>"
                      class="user-avatar"
                    />
                    <div class="status-dot"></div>
                    <div class="user-info">
                      <div class="user-name"><%= product.productName %></div>
                      <div class="user-id">
                        ID: #<%= (index + 1).toString().padStart(3, "0") %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="contact-cell">
                    <div class="contact-item phone">
                      <%= product.productCategory %>
                    </div>
                  </div>
                </td>
                <td>
                <div class="date-cell">
                  <div class="contact-item" style="font-weight: 600;">
                    $ <%= product.productPrice %>
                  </div>  
                </div>
                </td>
                <td>
                  <select
                    id="<%= product._id %>"
                    class="member-status status-select status-<%= product.productStatus %>"
                  >
                    <option value="PROCESS" <%= product.productStatus === 'PROCESS' ? 'selected' : '' %>>Process</option>
                    <option value="PAUSE" <%= product.productStatus === 'PAUSE' ? 'selected' : '' %>>Pause</option>
                    <option value="DELETE" <%= product.productStatus === 'DELETE' ? 'selected' : '' %>>Delete</option>
                  </select>
                </td>
                
                <td>
                <div class="date-cell">
                  <div class="contact-item shift">
                    <%= product.productLeftCount %>
                  </div>  
                </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Product Form Container -->
    <div class="product-form-container p-6">
        <button id="openFormBtn" class="btn btn-primary flex items-center gap-2">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Add Product
        </button>

        <div id="productFormModal" class="modal-overlay hidden">
            <div class="modal-content">
                <div class="p-6">
                    <div class="form-header">
                        <h2 class="form-title">NEW PRODUCT DETAIL</h2>
                        <button id="closeFormBtn" class="text-gray-500 hover:text-gray-700">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>

                   <form id="productForm" class="space-y-6" action="/admin/product/create" method="POST" enctype="multipart/form-data">
                        <!-- Product Status and Type Selection -->
                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-group">
                                <label class="form-label">Product Status</label>
                                <select name="productStatus" class="form-input" required>
                                    <option value="PROCESS">PROCESS</option>
                                    <option value="PAUSE" selected>PAUSE</option>
                                </select>
                            </div>
                            <div class="form-group">
                            <label class="form-label">Product Type</label>
                            <div class="flex gap-2">
                                <button type="button" id="regularTypeBtn" class="flex-1 btn-primary" onclick="setProductType('regular')">
                                Regular
                                </button>
                                <button type="button" id="comboTypeBtn" class="flex-1 btn-secondary" onclick="setProductType('combo')">
                                Combo
                                </button>
                            </div>
                            <input type="hidden" id="productType" name="productType" value="regular">
                            </div>
                        </div>

                        <!-- Product Name -->
                        <div class="form-group">
                            <label class="form-label">Product Name*</label>
                            <input type="text" name="productName" class="form-input" placeholder="Enter product name" required>
                        </div>

                        <!-- Price and Category -->
                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-group">
                            <label class="form-label">Price*</label>
                            <input type="number" name="productPrice" class="form-input" placeholder="0" min="0" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Category*</label>
                                <select name="productCategory" class="form-input" required>
                                    <option value="BURGERS" selected>BURGERS</option>
                                    <option value="CHICKEN">CHICKEN</option>
                                    <option value="PIZZA">PIZZA</option>
                                    <option value="MEXICAN">MEXICAN</option>
                                    <option value="SIDES">SIDES</option>
                                    <option value="BREAKFAST">BREAKFAST</option>
                                    <option value="SALADS">SALADS</option>
                                    <option value="DESSERTS">DESSERTS</option>
                                    <option value="BEVERAGES">BEVERAGES</option>
                                    <option value="SANDWICHES">SANDWICHES</option>
                                    <option value="APPETIZERS">APPETIZERS</option>
                                    <option value="COMBO">COMBO</option>
                                </select>
                            </div>
                        </div>

                        <!-- Size and Volume -->
                        <div class="grid grid-cols-2 gap-4">
                            <div id="product-collection">
                                <div class="form-group">
                                    <label class="form-label">Size</label>
                                    <select name="productSize" class="form-input">
                                        <option value="SMALL">SMALL</option>
                                        <option value="REGULAR" selected>REGULAR</option>
                                        <option value="LARGE">LARGE</option>
                                    </select>
                                </div>
                            </div>
                            <div id="product-volume" style="display: none;">
                                <div class="form-group">
                                    <label class="form-label">Volume</label>
                                    <select name="productVolume" class="form-input">
                                        <option value="0.5">0.5 litre</option>
                                        <option value="1" selected>1 litre</option>
                                        <option value="1.5">1.5 litre</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Available Times -->
                        <div class="form-group">
                            <label class="form-label">Available Times</label>
                            <div class="time-selection">
                                <% const times = ['ALL_DAY', 'BREAKFAST', 'LUNCH', 'DINNER']; %>
                                <% times.forEach(time => { %>
                                    <button type="button" class="time-btn <%= time === 'ALL_DAY' ? 'active' : 'inactive' %>" 
                                            onclick="toggleTime(this)">
                                        <%= time %>
                                    </button>
                                    <input type="checkbox" name="productTime" value="<%= time %>" 
                                           <%= time === 'ALL_DAY' ? 'checked' : '' %> style="display: none;">
                                <% }); %>
                            </div>
                        </div>

                        <!-- Spice Level and Preparation Time -->
                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-group">
                                <label class="form-label">Spice Level</label>
                                <select name="productSpice" class="form-input">
                                    <option value="NONE">NONE</option>
                                    <option value="MEDIUM" selected>MEDIUM</option>
                                    <option value="HOT">HOT</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Prep Time (minutes)</label>
                                <input type="number" name="preparationTime" value="15" class="form-input" min="1">
                            </div>
                        </div>

                        <!-- Calories and Left Count -->
                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-group">
                                <label class="form-label">Calories</label>
                                <input type="number" name="calories" class="form-input" placeholder="Enter calories" min="0">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Left Count</label>
                                <input type="number" name="productLeftCount" value="999" class="form-input" min="0">
                            </div>
                        </div>

                        <!-- Tags -->
                        <div class="form-group">
                            <label class="form-label">Tags</label>
                            <input type="text" name="tags" class="form-input" placeholder="comma separated tags (e.g., spicy, vegetarian)">
                        </div>

                        <!-- Product Description -->
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea name="productDesc" class="form-input form-textarea" placeholder="Enter product description"></textarea>
                        </div>

                        <!-- Combo Section -->
                        <div id="comboSection" class="border-t pt-4 hidden">
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div class="form-group">
                                    <label class="form-label">Combo Name*</label>
                                    <input type="text" name="comboName" class="form-input" placeholder="Enter combo name">
                                </div>
                                <div class="form-group">
                                <label class="form-label">Combo Price*</label>
                                <input type="number" name="comboPrice" class="form-input" placeholder="0" min="0" >
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div class="form-group">
                                    <label class="form-label">Combo Drink*</label>
                                    <select name="comboDrink" class="form-input">
                                        <option value="">Select a drink</option>
                                        <% availableProducts.filter(p => p.productCategory === 'BEVERAGES').forEach(product => { %>
                                            <option value="<%= product._id %>"><%= product.productName %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Combo Side*</label>
                                    <select name="comboSide" class="form-input">
                                        <option value="">Select a side</option>
                                        <% availableProducts.filter(p => p.productCategory === 'SIDES').forEach(product => { %>
                                            <option value="<%= product._id %>"><%= product.productName %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Main Items*</label>
                                <select name="comboItems" multiple class="form-input" style="height: auto;">
                                    <% availableProducts.filter(p => !['BEVERAGES', 'SIDES', 'COMBO'].includes(p.productCategory)).forEach(product => { %>
                                        <option value="<%= product._id %>"><%= product.productName %></option>
                                    <% }); %>
                                </select>
                                <p class="text-sm text-gray-500">Hold CTRL/CMD to select multiple items</p>
                            </div>
                        </div>

                        <!-- Product Images -->
                        <div class="form-group">
                          <label>Product Images (Max 5)</label>
                          <input type="file" name="productImages" multiple accept="image/*" class="hidden" id="imageUpload">
                          <button type="button" onclick="document.getElementById('imageUpload').click()" class="btn">
                            Select Images
                          </button>
                          <div id="imagePreviews" class="preview-container"></div>
                        </div>
                        <!-- Action Buttons -->
                        <div class="form-footer">
                            <button type="button" onclick="closeModal()" class="btn btn-secondary">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary">
                                Create Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
  </main>

  <script src="https://unpkg.com/lucide@latest"></script>
  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>